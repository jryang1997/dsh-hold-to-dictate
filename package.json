{
  "name": "@jryang1997/dsh-hold-to-dictate",
  "version": "2.8.0",
  "type": "module",
  "description": "Hold-to-talk dictation for the DeepSeek Harness composer: long-press the input box, release to transcribe into the draft",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "voice",
    "speech-to-text",
    "dictation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryang1997/dsh-hold-to-dictate.git"
  },
  "homepage": "https://github.com/jryang1997/dsh-hold-to-dictate#readme",
  "bugs": {
    "url": "https://github.com/jryang1997/dsh-hold-to-dictate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "polish.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "docs/*.md",
    "docs/dictation-demo.gif",
    "docs/gesture-overview.svg",
    "docs/gesture-overview.zh.svg",
    "docs/hands-free.gif",
    "docs/hands-free.en.gif",
    "docs/live-preview.gif",
    "docs/live-preview.en.gif",
    "docs/polish.png",
    "docs/polish.en.png",
    "docs/states.png",
    "docs/states.en.png",
    "docs/settings.png",
    "docs/settings.en.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "dsh-plugin-kit test",
    "check": "dsh-plugin-kit check && dsh-plugin-kit pack",
    "verify": "dsh-plugin-kit verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@jryang1997/dsh-plugin-kit": "https://codeload.github.com/jryang1997/dsh-plugin-kit/tar.gz/refs/tags/v1.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.19"
  },
  "dshPluginKit": {
    "version": 1,
    "dshRulesVersion": "installed-2026-10-23",
    "tests": {
      "include": [
        "*.test.mjs"
      ],
      "runner": "auto"
    },
    "pack": {
      "forbid": [
        "tests/",
        ".github/",
        ".node-version",
        "docs/adr/",
        "docs/agents/",
        ".scratch/"
      ],
      "require": [
        "index.js",
        "client.js",
        "polish.js",
        "cordis.patch.yml",
        "locale/en.json",
        "locale/zh.json"
      ]
    },
    "icon": {
      "declaration": "field",
      "budgetBytes": 65536
    },
    "locale": {
      "required": [
        "en",
        "zh"
      ],
      "metadata": [
        "title",
        "description"
      ]
    },
    "readme": {
      "files": [
        "README.md",
        "README.en.md"
      ],
      "parity": [
        "headings",
        "figures"
      ]
    },
    "screenshots": {
      "manifest": "screenshots.json",
      "strict": false
    },
    "versionSites": [
      {
        "file": "CHANGELOG.md",
        "pattern": "## \\[([0-9.]+)\\]",
        "flags": "m"
      },
      {
        "file": "client.js",
        "pattern": "const VERSION = '([^']+)'"
      }
    ]
  }
}
