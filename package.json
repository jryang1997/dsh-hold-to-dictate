{
  "name": "@jryang1997/dsh-hold-to-dictate",
  "version": "2.7.0",
  "type": "module",
  "description": "Hold-to-talk dictation for the DeepSeek Harness composer: long-press the input box, release to transcribe into the draft",
  "license": "MIT",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "voice",
    "speech-to-text",
    "dictation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryang1997/dsh-hold-to-dictate.git"
  },
  "homepage": "https://github.com/jryang1997/dsh-hold-to-dictate#readme",
  "bugs": {
    "url": "https://github.com/jryang1997/dsh-hold-to-dictate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "polish.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "docs/*.md",
    "docs/dictation-demo.gif",
    "docs/gesture-overview.svg",
    "docs/gesture-overview.zh.svg",
    "docs/hands-free.gif",
    "docs/hands-free.en.gif",
    "docs/live-preview.gif",
    "docs/live-preview.en.gif",
    "docs/polish.png",
    "docs/polish.en.png",
    "docs/states.png",
    "docs/states.en.png",
    "docs/settings.png",
    "docs/settings.en.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/locales.test.mjs && node tests/render.test.mjs && node tests/dictation-bridge.test.mjs && node tests/plan.test.mjs && node tests/live.test.mjs && node tests/polish.test.mjs && node tests/glossary.test.mjs && node tests/package.test.mjs",
    "check": "node --check index.js && node --check polish.js && node --check client.js && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
